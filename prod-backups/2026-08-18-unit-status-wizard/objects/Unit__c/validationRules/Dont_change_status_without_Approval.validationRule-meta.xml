<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dont_change_status_without_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Status__c) &amp;&amp; TEXT(Status__c) &lt;&gt;&apos;Draft&apos;&amp;&amp; $Profile.Name=&apos;Inventory Manager&apos;</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>To move Unit to the next stage, use &apos;Send for Approval&apos; first.</errorMessage>
</ValidationRule>
