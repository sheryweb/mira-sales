<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Financial Engine UI Access</label>
    <description>Read access to Engine_Enabled__c (master-switch mirror) for admins/reporting. No longer required to see the finance UI: the invoice/receipt/SOA surface always renders and the switch only blocks the actions server-side. Optional to assign.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <editable>false</editable>
        <field>Unit__c.Engine_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Engine_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Receipt__c.Engine_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Opportunity.Engine_Enabled__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
