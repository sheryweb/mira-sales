<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>N-Genius Payment Link User</label>
    <description
  >N-Genius Pay-by-Link screen: generate links, create/read Payment_Link__c. Money, status, reference and URL fields deliberately read-only; API_Log__c not granted. Also add External Credential Principal Access for NGenius or callouts fail.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>NGeniusPaymentLinkController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NGeniusInvoiceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NGeniusAuthService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NGeniusConfig</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NGeniusException</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Generate_Payment_Links</name>
    </customPermissions>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal
    >NGenius-NGeniusPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <objectPermissions>
        <object>Payment_Link__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
