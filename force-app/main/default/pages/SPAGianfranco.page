    <style>
        body {
            font-family: Arial, Helvetica, sans-serif !important;
            font-size: 9pt;
        }
        .container {
            margin: 0 auto;
            width: 95%;
            display:block;
        }
        table {
            width: 100%;
        }
        .table-title {
            width: 50%;
            font-size: 14px;
            font-weight: bold;
            background: #f1f1f1;
            border-bottom: none;
        }
        table, td {
            border: 1px solid #000;
            border-collapse: collapse;
        }
        table.half-width th {
            width: 50%;
        }
        table.half-width td {
            width: 50%;
        }
        table.small-columns th {
            width: 150px;
        }
        table.small-columns td {
            width: 150px;
        }
        th {
            padding: 2px 5px 2px 5px;
        }
        td {
            padding: 2px 5px 2px 5px;
        }

        div.footer {
            display: block;
            padding: 10px;
        }
        .page-break {
            page-break-after: always;
        }
        .small-para {
            width: 100%;
            margin: 0;
        }
        .ar-lang {
            direction: rtl;
            vertical-align: top;
        }
        @page {
            size: A4 portait;
            margin: 0cm 0cm 0cm 0cm;
        }
        @media print {
          div#page-footer {
              display: block;
              padding: 5px;
              position: fixed;
              bottom: 0;
              width: 100%;
          }
          #print-btn {
              display: none;
          }
        }
        .sub-title {
            font-weight: bold;
            text-align: center;
            vertical-align: top;
            width: 10% !important;
        }
        /*page numbers*/
        .page {
            position: relative;
            counter-increment: page;
        }
        div.page:after {
            display: block;
            content: " Page - "counter(page);
            position: absolute;
            bottom: -1060px;
            right: 335px;
            padding: 2px 12px;
            font-size: 9pt;
        }
        .rotate-right {
            transform: rotate(270deg);
            margin: 185px 0; /* Add margin to compensate for the rotation */
