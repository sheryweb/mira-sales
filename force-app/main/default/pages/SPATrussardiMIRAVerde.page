            <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 30px; text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MIRAVERDE}" height="20" /></div><br />

            <!-- Start of Payment Terms 2 -->
            <div class="table-div">
                <div class="row-div">
                    <div class="column-div table-title" style="border-right: none;">თ. გადახდის პირობები</div>
                    <div class="column-div table-title" style="border-left: none;">H. Payment Terms</div>
                </div>
