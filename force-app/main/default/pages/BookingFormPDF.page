<apex:page renderAs="" showHeader="true" title="Booking Form ({!oppData['Opportunity'].Unit__r.Title_Formula__c})" sidebar="false" standardStylesheets="false" applyBodyTag="true" applyHtmlTag="true" controller="BookingFormPDFController">
  <html>
      <head>
          <style>
              body {
                  font-family: Arial, Helvetica, sans-serif;
                  font-size: 12px;
                  //font-family: "Lucida Console", "Courier New", monospace;
              }
              .clearfix {
                  clear: both;
              }
              table {
                  width: 100%;
              }
              .table-div {
                  display: table;
                  width: 100%;
                  border: 1px solid #dddddd;
              }
              .row-div {
                  display: table-row;
              }
              .column-div {
                  display: table-cell;
                  padding: 5px;
                  border: 1px solid #dddddd;
              }
              .table-title {
                  width: 50%;
                  font-size: 14px;
                  font-weight: bold;
                  background: #f1f1f1;
                  border-bottom: none;
              }
              @page {
                  size: A4 portait;
                  margin: 0.2cm 0.2cm 0.2cm 0.2cm;
              }
              @media print {
                  div#page-footer {
                      display: block;
                      padding: 5px;
                      position: fixed;
                      bottom: 0;
                  }
                  #print-btn {
                      display: none;
                  }
              }
              .logo {
                  width: 100%;
                  padding-bottom: 10px;
                  text-align: right;
              }
              .ar-lang {
                  direction: rtl;
              }
              
            .page {
                 position: relative;
                 counter-increment: page;
            }
           /*page numbers*/
            div.page:after {
                display: block;
                content: " Page - "counter(page);
                position: absolute;
                bottom: -1050px;
                right: 15px;
                padding: 2px 12px;
                font-size: 14px;
            }
            .floor-plan-title {
                width: 100%;
                text-align: center;
                font-size: 20px;
                font-weight: bold;
            }
          </style>
      </head>
      <body class="page-content" onload="">
          <div class="footer grey-txt" id="page-footer">
              <div>Signed by the Purchaser ______________________________</div>
          </div>
          <p id="print-btn"><button onclick="window.print()">Download PDF</button></p>
          <div id="page-content">
              <div class='col size-1-of-2 page' style="text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div>
              <div class='logo'></div>
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div table-title" style="border-right: none;">OFFER TO PURCHASE</div>
                      <div class="column-div table-title ar-lang" style="border-left: none;">عرض للشراء</div>
                  </div>
              </div>
              <div class="table-div" style="text-align: justify;">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Date: {!oppData['BookingDate']}</div>
                      <div class="column-div" style="width: 50%; text-align: right;"><span style="direction: ltr !important;">{!oppData['BookingDate']}</span> :التاريخ</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Vendor: M I R A Developments LLC</div>
                      <div class="column-div ar-lang" style="width: 50%;">البائع: ام اي ار ايه للتطوير ش.ذ.م.م</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Project: {!oppData['Opportunity'].Unit__r.Project_Name_Text__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">المشروع: {!oppData['Opportunity'].Unit__r.Project_Name_Text_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Property: {!oppData['Opportunity'].Unit__r.Title_Formula__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الوحدة العقارية: {!oppData['arabicUnitType'][oppData['Opportunity'].Unit__r.Type__c]} {!oppData['Opportunity'].Unit__r.Title__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Building: {!oppData['Opportunity'].Unit__r.Building__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">البناية / المرحلة: {!oppData['Opportunity'].Unit__r.Building_Arabic_Text__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Unit: {!oppData['Opportunity'].Unit__r.Title__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رقم الوحدة: {!oppData['Opportunity'].Unit__r.Title__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">No. of Bedrooms: {!IF(oppData['Opportunity'].Unit__r.Number_of_Bedrooms__c == 0, 'STUDIO', oppData['Opportunity'].Unit__r.Number_of_Bedrooms__c)}</div>
                      <div class="column-div ar-lang" style="width: 50%;">عدد الغرف: {!IF(oppData['Opportunity'].Unit__r.Number_of_Bedrooms__c == 0, 'استوديو', oppData['Opportunity'].Unit__r.Number_of_Bedrooms__c)}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(oppData['Opportunity'].Unit__r.Type__c == 'Apartment', 'none', '')}">
                      <div class="column-div" style="width: 50%;">Plot Area: sq.ft. {!oppData['formattedNumbers'].formattedPlotArea}</div>
                      <div class="column-div ar-lang" style="width: 50%;">مساحة الأرض: sq.ft. {!oppData['formattedNumbers'].formattedPlotArea}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Total Area: sq.ft. {!oppData['formattedNumbers'].formattedTotalArea}</div>
                      <div class="column-div ar-lang" style="width: 50%;">المساحة الإجمالية: sq.ft. {!oppData['formattedNumbers'].formattedTotalArea}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Purchase Price: AED {!oppData['formattedNumbers'].formattedUnitCost}</div>
                      <div class="column-div ar-lang" style="width: 50%;">ثمن الشراء: {!oppData['formattedNumbers'].formattedUnitCost} درهم اماراتي</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">VAT%: 0.00%</div>
                      <div class="column-div ar-lang" style="width: 50%;">ضريبة القيمة المضافة: 0.00%</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">First Installment Payment ("Deposit"): AED {!oppData['formattedNumbers'].firstInstallment}</div>
                      <div class="column-div ar-lang" style="width: 50%;">("العربون") الدفعة الأولى: {!oppData['formattedNumbers'].firstInstallment} درهم اماراتي</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Registration Fee: {!oppData['Opportunity'].Registration_Fees__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رسوم التسجيل: {!oppData['registrationFee']}</div>
                  </div>
              </div>
              <br />
           <!-- Start of Purchaser Information -->              
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div table-title" style="border-right: none;">{!IF(hasJointOwners, 'PURCHASER 1 INFORMATION', 'PURCHASER INFORMATION')}</div>
                      <div class="column-div table-title ar-lang" style="border-left: none;">{!IF(hasJointOwners, 'معلومات المشتري رقم 1', 'معلومات المشتري')}</div>
                  </div>
              </div>
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Name: {!oppData['Opportunity'].Account.Name}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الاسم: {!oppData['arabicAccountName']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Ownership Share: {!oppData['Opportunity'].Ownership_Share_of_the_Main_Purchaser__c}%</div>
                      <div class="column-div ar-lang" style="width: 50%;">حصة الملكية: %{!oppData['Opportunity'].Ownership_Share_of_the_Main_Purchaser__c}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(oppData['Opportunity'].Account.RecordTypeId <> '012Hp000001yUTFIA2', '', 'none')}">
                      <div class="column-div" style="width: 50%;">License No. (For legal entities): {!oppData['licenseNumberValue']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رقم الرخصة (للشركات): {!oppData['licenseNumberValue']}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(oppData['Opportunity'].Account.RecordTypeId <> '012Hp000001yUTFIA2', '', 'none')}">
                      <div class="column-div" style="width: 50%;">Country of Incorporation: {!oppData['incorporationCountry']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">البلد الذي تأسست فيه: {!oppData['incorporationCountryArabic']}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(oppData['Opportunity'].Account.RecordTypeId <> '012Hp000001yUTFIA2', 'none', '')}">
                      <div class="column-div" style="width: 50%;">Nationality: {!oppData['Opportunity'].Account.Nationality__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الجنسية: {!oppData['Opportunity'].Account.Nationality_Arabic__c}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(oppData['Opportunity'].Account.RecordTypeId <> '012Hp000001yUTFIA2', 'none', '')}">
                      <div class="column-div" style="width: 50%;">Passport No: {!oppData['Opportunity'].Account.Passport_No__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رقم جواز السفر: {!oppData['Opportunity'].Account.Passport_No__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">P.O. Box / Postal Code: {!oppData['Opportunity'].Account.BillingPostalCode}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الرمز البريدي / ص.ب: {!oppData['Opportunity'].Account.Postal_Code_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">City: {!oppData['Opportunity'].Account.BillingCity}&nbsp; &nbsp; &nbsp; &nbsp; Country: {!oppData['Opportunity'].Account.BillingCountry}</div>
                      <div class="column-div ar-lang" style="width: 50%;">المدينة: {!oppData['Opportunity'].Account.City_Arabic__c}&nbsp; &nbsp; &nbsp; &nbsp; البلد: {!oppData['Opportunity'].Account.Country_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Address: {!oppData['Opportunity'].Account.BillingStreet}</div>
                      <div class="column-div ar-lang" style="width: 50%;">العنوان: {!oppData['Opportunity'].Account.Address__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Mobile: {!oppData['personInformation']['personMobile']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الهاتف المتحرك: {!oppData['personInformation']['personMobile']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Telephone: {!oppData['personInformation']['personPhone']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الهاتف: {!oppData['personInformation']['personPhone']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Email: {!oppData['personInformation']['personEmail']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">البريد الإلكتروني: {!oppData['personInformation']['personEmail']}</div>
                  </div>
              </div>
              
              <div class="table-div" style="text-align: justify;">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Note: The above address/contact details are considered the Purchaser’s primary address and chosen domicile and shall be printed on the Vendor’s Sales and Purchase Agreement and used for all communications / correspondences with the Purchaser.</div>
                      <div class="column-div ar-lang" style="width: 50%;">ملاحظة: إن العنوان/بيانات الاتصال أعلاه تعتبر العنوان الأساسي والمختار للمشتري وسيتم طباعتها على اتفاقية البيع والشراء الخاصة بالبائع واعتمادها في جميع الاتصالات/المراسلات مع المشتري.</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Note: Customer Due Diligence is required by the Vendor under applicable laws. </div>
                      <div class="column-div ar-lang" style="width: 50%;">ملاحظة: تطلب التدقيق اللازم للعميل من قبل البائع بموجب القوانين  المطبقة.</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Delivery Address for the Sales and Purchase Agreement: the following address will be used solely for the delivery of the Vendor’s Sales and Purchase Agreement. All other communications, correspondences, notifications and notices shall be dispatched/delivered to the primary address above.</div>
                      <div class="column-div ar-lang" style="width: 50%;">عنوان تسليم الاتفاقية البيع والشراء: سيتم استخدام العنوان التالي فقط لتسليم اتفاقية البيع والشراء الخاصة بالبائع. وسيتم إرسال / تسليم جميع المراسلات والإخطارات والإشعارات الأخرى إلى العنوان الأساسي المذكور أعلاه.</div>
                  </div>
              </div>
            <!--<div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div><br />-->
           <apex:variable value="{!1}" var="count" />
           <apex:outputPanel rendered="{!hasJointOwners}">
           <apex:repeat value="{!jointOwnerAccounts}" var="jOwner">
              <apex:variable value="{!count+1}" var="count" />
              <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right; display: {!IF((count == 2 || count == 4), '', 'none')}"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div><br />
              
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div table-title" style="border-right: none;">PURCHASER {!TEXT(count)} INFORMATION</div>
                      <div class="column-div table-title ar-lang" style="border-left: none;">معلومات المشتري رقم {!TEXT(count)}</div>
                  </div>
              </div>
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Name: {!IF(jOwner.IsPersonAccount, IF(ISBLANK(jOwner.FirstName), jOwner.Name, jOwner.FirstName + ' ' + jOwner.MiddleName + ' ' + jOwner.LastName), jOwner.Name)}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الاسم: {!IF(jOwner.IsPersonAccount, jOwner.Contact_First_Name_Arabic__pc+' '+jOwner.Contact_Middle_Name_Arabic__pc+' '+jOwner.Contact_Last_Name_Arabic__pc, jOwner.Account_Name_Arabic__c)}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Ownership Share: {!jointOwnersOwnershipById[jOwner.Id]}%</div>
                      <div class="column-div ar-lang" style="width: 50%;">حصة الملكية: %{!jointOwnersOwnershipById[jOwner.Id]}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(jOwner.IsPersonAccount, 'none', '')}">
                      <div class="column-div" style="width: 50%;">License No. (For legal entities): {!jointOwnersLicenseValuesById[jOwner.Id]}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رقم الرخصة (للشركات): {!jointOwnersLicenseValuesById[jOwner.Id]}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(jOwner.IsPersonAccount, 'none', '')}">
                      <div class="column-div" style="width: 50%;">Country of Incorporation: {!jointOwnersIncorporationValuesById[jOwner.Id]}</div>
                      <div class="column-div ar-lang" style="width: 50%;">البلد الذي تأسست فيه: {!jointOwnersIncorporationValuesArabicById[jOwner.Id]}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(jOwner.IsPersonAccount, '', 'none')}">
                      <div class="column-div" style="width: 50%;">Nationality: {!jOwner.Nationality__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الجنسية: {!jOwner.Nationality_Arabic__c}</div>
                  </div>
                  <div class="row-div" style="display: {!IF(jOwner.IsPersonAccount, '', 'none')}">
                      <div class="column-div" style="width: 50%;">Passport No: {!jOwner.Passport_No__c}</div>
                      <div class="column-div ar-lang" style="width: 50%;">رقم جواز السفر: {!jOwner.Passport_No__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">P.O. Box / Postal Code: {!jOwner.BillingPostalCode}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الرمز البريدي / ص.ب: {!jOwner.Postal_Code_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">City: {!jOwner.BillingCity}&nbsp; &nbsp; &nbsp; &nbsp; Country: {!jOwner.BillingCountry}</div>
                      <div class="column-div ar-lang" style="width: 50%;">المدينة: {!jOwner.City_Arabic__c}&nbsp; &nbsp; &nbsp; &nbsp; البلد: {!jOwner.Country_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Address: {!jOwner.BillingStreet}</div>
                      <div class="column-div ar-lang" style="width: 50%;">العنوان: {!jOwner.Address__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Mobile: {!jOwner.PersonMobilePhone}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الهاتف المتحرك: {!jOwner.PersonMobilePhone}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Telephone: {!jOwner.Phone}</div>
                      <div class="column-div ar-lang" style="width: 50%;">الهاتف: {!jOwner.Phone}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Email: {!jOwner.PersonEmail}</div>
                      <div class="column-div ar-lang" style="width: 50%;">البريد الإلكتروني: {!jOwner.PersonEmail}</div>
                  </div>
              </div>
           </apex:repeat>
           </apex:outputPanel>
           <!-- End of Purchaser Information -->

              <br />
              
              <!-- Start of Purchasers Summary -->
              <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right; display: {!IF(AND(hasSharedContacts, NOT(hasJointOwners)), '', 'none')}"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div><br />
              <apex:outputPanel rendered="{!hasSharedContacts}">
              <div class="table-div" style="text-align: justify;">
                  <div class="row-div" style="text-align: center;">
                      <div class="column-div" style="width: 20%;">Name</div>
                      <div class="column-div" style="width: 20%;">Position in Company</div>
                      <div class="column-div" style="width: 10%;">Company Share</div>
                      <div class="column-div" style="width: 20%;">Nationality</div>
                      <div class="column-div" style="width: 20%;">Passport No.</div>
                  </div>
              </div>
              <apex:repeat value="{!sharedContactList}" var="sCont">
              <div class="table-div" style="text-align: justify;">
                  <div class="row-div" style="text-align: center;">
                      <div class="column-div" style="width: 20%;">{!sCont.FirstName} {!sCont.MiddleName} {!sCont.LastName}</div>
                      <div class="column-div" style="width: 20%;">{!sCont.Position_in_Company__c}</div>
                      <div class="column-div" style="width: 10%;">{!sCont.Company_Share__c}%</div>
                      <div class="column-div" style="width: 20%;">{!sCont.Nationality__c}</div>
                      <div class="column-div" style="width: 20%;">{!sCont.Passport_No__c}</div>
                  </div>
              </div>
              </apex:repeat>
              </apex:outputPanel>
              <!-- End of Purchasers Summary -->
              <br />
              <!-- Start of Due Diligence -->
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div table-title" style="border-right: none;">{!IF(hasJointOwners, 'CUSTOMER DUE DILIGENCE - PURCHASER 1', IF(oppData['personAccountRecordType'] == oppData['accountRecordType'], 'CUSTOMER DUE DILIGENCE - PURCHASER 1', 'CUSTOMER DUE DILIGENCE - SHAREHOLDER 1'))}</div>
                      <div class="column-div table-title ar-lang" style="border-left: none;">{!IF(hasJointOwners, 'التدقيق اللازم للعميل - المشتري رقم 1', IF(oppData['personAccountRecordType'] == oppData['accountRecordType'], 'التدقيق اللازم للعميل - المشتري رقم 1', 'التدقيق اللازم للعميل - المساهم رقم 1'))}</div>
                  </div>
              </div>
              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Date of Birth: 
                          <apex:outputText value="{0, date, dd MMMM yyyy}">
                              <apex:param value="{!oppData['DueDeligence']['contactBirthDate']}" /> 
                          </apex:outputText>
                      </div>
                      <div class="column-div" style="width: 50%; text-align: right;">
                          <apex:outputText value="{0, date, dd MMMM yyyy}">
                              <apex:param value="{!oppData['DueDeligence']['contactBirthDate']}" /> 
                          </apex:outputText>
                           :تاريخ الميلاد
                      </div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Place of Birth: {!oppData['DueDeligence']['contactBirthPlace']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">مكان الميلاد: {!oppData['DueDeligence']['contactBirthPlaceArabic']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Occupation and Name of Employer: {!oppData['DueDeligence']['contactOccupation']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">المهنة /صاحب العمل: {!oppData['DueDeligence']['contactOccupationArabic']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Nature of Business: {!oppData['DueDeligence']['contactBusinessNature']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">طبيعة العمل: {!oppData['DueDeligence']['contactBusinessNatureArabic']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Source of Fund: {!oppData['DueDeligence']['contactFundSource']}{!IF(oppData['DueDeligence']['contactFundSource'] == 'Other', '__________', '')}</div>
                      <div class="column-div ar-lang" style="width: 50%;">مصدر الأموال: {!oppData['sourceOfFundArabic']}</div>
