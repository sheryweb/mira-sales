              <div class="table-div">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Are you being assisted by any of Vendor’s registered agents: {!oppData['agentAssistEng']}</div>
                      <div class="column-div ar-lang" style="width: 50%;">هل تمت مساعدتكم من قبل أي من الوسطاء المسجلين مع البائع: {!oppData['agentAssistArabic']}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Agency Name: {!oppData['Opportunity'].Agency__r.Name}</div>
                      <div class="column-div ar-lang" style="width: 50%;">اسم الوسيط العقاري: {!oppData['Opportunity'].Agency__r.Account_Name_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Agency Representative’s Name: {!oppData['Opportunity'].Agent__r.Name}</div>
                      <div class="column-div ar-lang" style="width: 50%;">اسم ممثل الوسيط العقاري: {!oppData['Opportunity'].Agent__r.Contact_First_Name_Arabic__c} {!oppData['Opportunity'].Agent__r.Contact_Middle_Name_Arabic__c} {!oppData['Opportunity'].Agent__r.Contact_Last_Name_Arabic__c}</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;">Agency Representative’s Signature:</div>
                      <div class="column-div ar-lang" style="width: 50%;">توقيع ممثل الوسيط العقاري:</div>
                  </div>
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;"><br />________________________<br />{!IF(hasJointOwners, 'Puchaser 1 Signature', IF(oppData['personAccountRecordType'] == oppData['accountRecordType'], 'Puchaser 1 Signature', 'Purchaser Signature'))}<br /><br />{!oppData['Opportunity'].Account.Name}</div>
                      <div class="column-div ar-lang" style="width: 50%;"><br />________________________<br />{!IF(hasJointOwners, 'توقيع المشتري رقم 1', IF(oppData['personAccountRecordType'] == oppData['accountRecordType'], 'توقيع المشتري رقم 1', 'توقيع المشتري'))}<br /><br/ >{!oppData['arabicAccountName']}</div>
                  </div>
                </div>
                
                <apex:variable value="{!1}" var="countpur" />
                <apex:outputPanel rendered="{!hasJointOwners}">
                <apex:repeat value="{!jointOwnerAccounts}" var="jop">
                <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right; display: {!IF(countpur == 3, '', 'none')}"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div><br />
                <apex:variable value="{!countpur+1}" var="countpur" />
                <div class="table-div" style="border-top: 0px;">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;"><br />________________________<br />Puchaser {!TEXT(countpur)} Signature<br /><br />{!IF(jop.IsPersonAccount, IF(ISBLANK(jop.FirstName), jop.Name, jop.FirstName + ' ' + jop.MiddleName + ' ' + jop.LastName), jop.Name)}</div>
                      <div class="column-div ar-lang" style="width: 50%;"><br />________________________<br />توقيع المشتري رقم {!TEXT(countpur)}<br /><br/ >{!jointArabicNameById[jop.Id]}</div>
                  </div>
                </div>
                </apex:repeat>
                </apex:outputPanel>
               
                <div class="table-div" style="border-top: 0px;">
                  <div class="row-div">
                      <div class="column-div" style="width: 50%;"><br />________________________<br />Sales Advisor Name &amp; Signature (on Behalf of the Vendor)<br /><br />{!oppData['Opportunity'].Owner.Name}</div>
                      <div class="column-div ar-lang" style="width: 50%;"><br />________________________<br />اسم وتوقيع مستشار المبيعات (ممثل البائع)<br /><br />{!oppData['Opportunity'].Owner.Name}</div>
                  </div>
              </div>
             <!-- End of Agent's Information -->
             
             <!-- Start of Floor Plan -->
             <apex:repeat value="{!imageUrlToStyleKeySet}" var="imageUrlToStyleKey">
             <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div>
             <p style="margin: 0;">FLOOR PLAN</p>
             <div class='col align-center' style="text-align: center;">
                 <apex:image url="{!imageUrlToStyleKey}" height="1010px" />
                 <div style='color: #9A9EA9'>{!imageUrlToDesc[imageUrlToStyleKey]}</div>
             </div>
             </apex:repeat>
             <!-- End of Floor Plan -->
             
          </div>
      </body>
  </html>
</apex:page>