<script>
   window.addEventListener('load', async function() {
        // Wait for fonts (critical for Arabic/Georgian)
        await document.fonts.ready;
        
        // Wait for images
        const images = Array.from(document.images);
        await Promise.all(images.map(img =>
            img.complete ? Promise.resolve() 
                        : new Promise(r => { img.onload = img.onerror = r; })
        ));
        
        // Small buffer for any remaining layout
        await new Promise(r => setTimeout(r, 300));
        
        // Set up the redirect BEFORE calling print
        window.addEventListener('afterprint', function() {
            window.location.href = 'https://miradevelopments.lightning.force.com/lightning/r/Account/{!accData["agencyAccount"].Id}/view';  
            // or: window.location.href = '/' + recordId;  to go back to the record
            // or: window.close();  if the page opened in a new tab
        });
        
        // Now trigger the dialog
        window.print();
    });
    </script>
