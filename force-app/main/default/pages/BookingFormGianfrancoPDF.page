              }
              .column-div {
                  display: table-cell;
                  padding: 5px;
                  border: 1px solid #dddddd;
              }
              .table-title {
                  width: 50%;
                  font-size: 14px;
                  font-weight: bold;
                  background: #f1f1f1;
                  border-bottom: none;
              }
              @page {
                  size: A4 portait;
                  margin: 0.2cm 0.2cm 0.2cm 0.2cm;
              }
              @media print {
                  div#page-footer {
                      display: block;
                      padding: 5px;
                      position: fixed;
                      bottom: 0;
                  }
                  #print-btn {
                      display: none;
                  }
              }
              .logo {
                  width: 100%;
                  padding-bottom: 10px;
                  text-align: right;
              }
              .ar-lang {
                  direction: rtl;
              }
              
            .page {
                 position: relative;
                 counter-increment: page;
            }
           /*page numbers*/
            div.page:after {
                display: block;
                content: " Page - "counter(page);
                position: absolute;
                bottom: -1050px;
                right: 15px;
                padding: 2px 12px;
                font-size: 14px;
            }
            .floor-plan-title {
                width: 100%;
                text-align: center;
                font-size: 20px;
                font-weight: bold;
            }
            .rotate-right {
                transform: rotate(90deg);
                margin: 155px 0; /* Add margin to compensate for the rotation */
