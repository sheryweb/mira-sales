                      <div class="column-div" style="width: 15%; text-align: center;">{!ppc['paymentDate']}</div>
                      <div class="column-div" style="width: 10%; text-align: center;">{!ppc['percent']}%</div>
                      <div class="column-div" style="width: 15%; text-align: center;">{!ppc['amount']}</div>
                      <div class="column-div" style="width: 22%; text-align: center;">{!ppc['milestone']}</div>
                      <div class="column-div" style="width: 22%; text-align: center;">{!oppData['arabicMilestones'][ppc['milestone']]}</div>
                  </div>
             </div>
             </apex:repeat>
             </apex:outputPanel>
             <!-- End of Payment Plan Continuation -->
             
             <!-- Start of Floor Plan -->
             <apex:repeat value="{!imageUrlToStyleKeySet}" var="imageUrlToStyleKey">
             <div class='col size-1-of-2 page' style="page-break-before: always; margin-top: 2%; text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div>
             <p style="margin: 0;">FLOOR PLAN</p>
             <div class='col align-center' style="text-align: center;">
                <apex:repeat value="{!imageUrlToStyleKeySet}" var="imageUrlToStyleKey">
                    <div class='col align-center' style="width:{!imageUrlToStyle[imageUrlToStyleKey]}; background-color: #F9F0E9; height: 920px;">
                        <apex:image url="{!imageUrlToStyleKey}" height="900px" width="600px" styleClass="" />
                        <div style='color: #9A9EA9'>{!imageUrlToDesc[imageUrlToStyleKey]}</div>
                    </div>
                </apex:repeat>
             </div>
             </apex:repeat>
             <!-- End of Floor Plan -->
             
          </div>
      </body>
  </html>
</apex:page>