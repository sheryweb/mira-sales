                  //font-family: "Lucida Console", "Courier New", monospace;
              }
              ul.dash {
                  list-style: none;
                  padding-left: 0;
              }
              ul.dash > li {
                  padding-left: 2em;
                  text-indent: -1em;
              }
              ul.dash > li:before {
                  content: "- ";
                  text-indent: -1em;
              }
              ul.dash-rtl {
                  list-style: none;
                  padding-right: 0;
              }
              ul.dash-rtl > li {
                  padding-right: 2em;
                  text-indent: -1em;
              }
              ul.dash-rtl > li:before {
                  content: "- ";
                  text-indent: -1em;
              }
              .clearfix {
