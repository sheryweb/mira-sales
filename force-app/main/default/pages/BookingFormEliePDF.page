<apex:page renderAs="" showHeader="true" title="Booking Form" sidebar="false" standardStylesheets="false" applyBodyTag="true" applyHtmlTag="true" controller="BookingFormEliePDFController">
<html>
    <head>
        <style>
            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 12px;
                //font-family: "Lucida Console", "Courier New", monospace;
            }
            .clearfix {
                clear: both;
            }
            table {
                width: 100%;
            }
            .table-div {
                display: table;
                width: 100%;
                border: 1px solid #dddddd;
            }
            .row-div {
                display: table-row;
            }
            .column-div {
                display: table-cell;
                padding: 5px;
            }
            .table-title {
                width: 100%;
                font-size: 14px;
                font-weight: bold;
                background: #f1e8f7;
                border-bottom: none;
            }
            @page {
                size: A4 portait;
                margin: 0.5cm 1cm 0.5cm 1cm;
            }
            @media print {
                div#page-footer {
                    display: block;
                    padding: 5px;
                    position: fixed;
                    bottom: 0;
                }
                #print-btn {
                    display: none;
                }
            }
            .logo {
                width: 100%;
                padding-bottom: 10px;
                text-align: right;
            }
            .ar-lang {
                direction: rtl;
            }
            
        .page {
                position: relative;
                counter-increment: page;
        }
        /*page numbers*/
        div.page:after {
            display: block;
            content: " Page - "counter(page);
            position: absolute;
            bottom: -1110px;
            right: 15px;
            padding: 2px 12px;
            font-size: 14px;
        }
        .floor-plan-title {
            width: 100%;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
        }
        .text-justify {
            text-align: justify;
        }
        </style>
    </head>
    <body class="page-content" onload="">
        <div class="footer grey-txt" id="page-footer">
            <div>Signed by the Purchaser ______________________________</div>
        </div>
        <p id="print-btn"><button onclick="window.print()">Download PDF</button></p>
        <div id="page-content">
            <div class="table-div page" style="border: none !important;">
                <div class="row-div">
                    <div class="column-div" style="width: 30%;"><apex:image styleClass="float-right" url="{!$Resource.ALogo}" height="40" /></div>
                    <div class="column-div" style="width: 40%; text-align: center;"><apex:image styleClass="float-right" url="{!$Resource.PostElieLogoBig}" height="80" /></div>
                    <div class="column-div" style="width: 30%; text-align: right;"><apex:image styleClass="float-right" url="{!$Resource.MiraDocLogo}" height="40" /></div>
                </div>
            </div>
            <br />
            <div class="table-div">
