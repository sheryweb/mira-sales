<apex:page controller="ReceiptPDFController" action="{!blockIfDisabled}" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
    <head>
        <style type="text/css">
            @page {
                size: A4 portrait; /* Changed back to portrait */
                margin: 8mm; /* Further reduced margin to fit more content */
                /*@bottom-center {
                    content: "Page " counter(page) " of " counter(pages);
                }*/
            }
            
            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 14px; /* Increased from 9px */
                color: #333;
                line-height: 1.2;
                margin: 0;
                padding: 0;
            }
            
            .container {
                width: 100%; /* Full width */
                margin: 0 auto;
                padding: 0;
                box-sizing: border-box;
            }
            
            .header {
                text-align: center;
                margin-bottom: 6px; /* Reduced margin */
            }
            
            .header p {
                margin: 1px 0;
                font-size: 14px;
            }
            
            hr {
                border: none;
                border-top: 1px solid #ccc;
                margin: 4px 0;
            }
            
            .details {
                margin-bottom: 6px; /* Reduced margin */
            }
            
            .details p {
                margin: 2px 0;
                font-size: 14px;
            }
            
            /* Table fixes */
            .table-container {
                margin: 8px 0;
                width: 100%;
                overflow: hidden;
            }
            
            .table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 6px;
                table-layout: fixed; /* Fixed table layout */
                font-size: 14px; /* Increased from 8px */
            }
            
            .table th, .table td {
                border: 1px solid #ddd;
                padding: 3px 2px;
                text-align: left;
                word-wrap: break-word;
                overflow-wrap: break-word;
                white-space: normal;
                max-width: 100%;
                font-size: 14px;
            }
            
            .table th {
                background-color: #f2f2f2;
                font-weight: bold;
            }
            
            /* Column width adjustments - more proportional */
            .table .narrow-col {
                width: 10%;
            }
            
            .table .medium-col {
                width: 14%;
            }
            
            .table .wide-col {
                width: 18%;
            }
            
            .payment-table-container {
                margin-bottom: 6px;
            }
            
            .terms {
                margin-top: 8px;
                font-size: 14px; /* Increased from 8px */
            }
            
            .terms ul {
                padding-left: 4px;
                margin: 2px 0;
            }
            
            .terms li {
                list-style-type: none;
                margin: 1px 0;
                font-size: 14px;
                line-height: 1.3;
                word-wrap: break-word;
                overflow-wrap: break-word;
            }
            
            /* Flex container adjustments */
            .flex-container {
                display: table;
                width: 100%;
                margin: 8px 0;
                table-layout: fixed;
            }
            
            .flex-item-left {
                display: table-cell;
                width: 65%;
                vertical-align: middle;
                word-wrap: break-word;
                overflow-wrap: break-word;
                padding-right: 3px;
                font-size: 14px; /* Increased from 8px */
            }
            
            .flex-item-right {
                display: table-cell;
                width: 35%;
                text-align: right;
                vertical-align: middle;
                word-wrap: break-word;
                overflow-wrap: break-word;
                font-size: 14px; /* Increased from 8px */
            }
            
            .error-message {
                color: #C00;
                font-weight: bold;
                padding: 6px;
                margin-bottom: 8px;
                border: 1px solid #C00;
                background-color: #FFF0F0;
                font-size: 14px;
            }
            
            /* Row fixes */
            .row {
                display: table;
                width: 100%;
                margin-bottom: 3px;
                table-layout: fixed;
            }
            
            .column {
                display: table-cell;
                width: 33.33%;
                padding-right: 2px;
                box-sizing: border-box;
                word-wrap: break-word;
                overflow-wrap: break-word;
                white-space: normal;
                vertical-align: top;
                font-size: 14px;
            }
        </style>
    </head>
    <body>
        <!-- Display any error messages -->
        <apex:outputPanel layout="block">
            <apex:messages style="color: #C00; font-weight: bold; padding: 6px; margin-bottom: 8px; border: 1px solid #C00; background-color: #FFF0F0; font-size: 14px;" />
        </apex:outputPanel>
        
        <!-- Only render the receipt content if we have valid data -->
        <apex:outputPanel layout="none" rendered="{!receipt.Id != null}">
            <div class="container">
                <div class="header">
                    <img src="{!$Resource.MiraDocLogo}" alt="Mira Logo" style="height: 40px;"/><br />
                    <p><strong>M I R A DEVELOPMENTS LLC</strong></p>
                    <p>Park Heights Square 1, Dubai Hills, Office No. 601-606</p>
                    <p>P.O. BOX 213983, DUBAI, UNITED ARAB EMIRATES</p>
                    <p>VAT: 104070222500003</p>
                </div>
                <p style="text-align: center; font-size: 14px;"><strong>RECEIPT VOUCHER</strong></p>
                <hr />
                <div class="details">
                    <p>
                        <span><strong>Journal No.:</strong> {!receipt.Name}</span>
                        <span style="float: right;"><strong>Date:</strong> {!formattedReceiptDate}</span>
                    </p>
                    <br />
                    <p style="display: inline;"><strong>Received with thanks from:</strong> {!fullCustomerName}</p>
                    <br /><br />
                    <p><strong>Deposited To:</strong> {!receipt.Deposited_To__c}</p>
                    <hr />
                    <div class="row">
                        <div class="column" style="width: 75%"><strong>Description:</strong> {!receipt.Description__c}</div>
                        <div class="column" style="width: 25%"><strong>Voucher:</strong> {!IF(receipt.Unit__r.Type__c == 'Retail', receipt.Voucher_Number_Retail__c, receipt.Voucher_Number__c)}</div>
                    </div><br />
                    <div class="row">
                        <div class="column" style="width: 50%"><strong>Project:</strong> {!receipt.Project_Name__c}</div>
                        <div class="column" style="width: 25%"><apex:outputPanel rendered="{!receipt.Project_Name__c != 'MIRA Villas Designed by Bentley Home'}"><strong>Tower:</strong> {!receipt.Unit_Building__c}</apex:outputPanel></div>
                        <div class="column" style="width: 25%"><strong>Unit No:</strong> {!receipt.Unit_No__c}</div>
                    </div>
                </div>
                <br />
                <div class="table-container">
                    <table class="table">
                        <tr>
                            <th class="medium-col">Customer Reference</th>
                            <th class="narrow-col" style="width: 80px;">Invoice</th>
                            <th class="narrow-col">Date</th>
                            <th class="narrow-col">Due Amount</th>
                            <th class="narrow-col">Paid Amount</th>
                            <th class="narrow-col">Balance</th>
                        </tr>
                        <apex:repeat value="{!formattedInvoices}" var="invoice">
                            <tr>
                                <td>{!invoice['Description__c']}</td>
                                <td>{!invoice['Invoice_Number__c']}</td>
                                <td>{!invoice['formattedInvoiceDate']}</td>
                                <td>{!invoice['formattedDueAmount']}</td>
                                <td>{!invoice['formattedPaidAmount']}</td>
                                <td>{!invoice['formattedBalanceAmount']}</td>
                            </tr>
                        </apex:repeat>
                    </table>
                </div>
                
                <div class="table-container">
                    <apex:repeat value="{!payments}" var="payment">
                        <div class="payment-table-container">
                            <!-- Cash, Bank Transfer, Card, Online Payment -->
                            <apex:outputPanel layout="none" rendered="{!payment['isSimplePayment']}">
                                <table class="table">
                                    <tr>
                                        <th colspan="3">Payment By {!payment['Mode_of_Payment__c']}</th>
                                    </tr>
                                    <tr>
                                        <th class="medium-col">Payment Reference</th>
                                        <th class="medium-col">Amount</th>
                                        <th class="medium-col">Mode of Payment</th>
                                    </tr>
                                    <tr>
                                        <td>{!payment['Reference_Number__c']}</td>
                                        <td>{!payment['formattedReceiptAmount']}</td>
                                        <td>{!payment['Mode_of_Payment__c']}</td>
                                    </tr>
                                </table>
                            </apex:outputPanel>

                            <!-- Cheque -->
                            <apex:outputPanel layout="none" rendered="{!payment['isChequePayment']}">
                                <table class="table">
                                    <tr>
                                        <th colspan="6">Payment By Cheque</th>
                                    </tr>
                                    <tr>
                                        <th>Payment Reference</th>
                                        <th>Invoice</th>
                                        <th>Amount</th>
                                        <th>Cheque#</th>
                                        <th>Cheque Date</th>
                                        <th>Bank Name</th>
                                    </tr>
                                    <tr>
                                        <td>{!payment['Reference_Number__c']}</td>
                                        <td>
                                            <apex:outputText value="{!payment['Invoice_Number__c']}" rendered="{!payment['Invoice__c'] != null}" />
                                            <apex:outputText value="-" rendered="{!payment['Invoice__c'] == null}" />
                                        </td>
                                        <td>{!payment['formattedReceiptAmount']}</td>
                                        <td>{!payment['Cheque_Number__c']}</td>
                                        <td>{!payment['formattedChequeDate']}</td>
                                        <td>{!payment['Bank_Name__c']}</td>
                                    </tr>
                                </table>
                            </apex:outputPanel>

                            <!-- POS Machine -->
                            <apex:outputPanel layout="none" rendered="{!payment['isPOSPayment']}">
                                <table class="table">
                                    <tr>
                                        <th colspan="5">Payment By POS Machine</th>
                                    </tr>
                                    <tr>
                                        <th>Payment Reference</th>
                                        <th>Invoice</th>
                                        <th>Amount</th>
                                        <th>POS Receipt#</th>
                                        <th>Mode of Payment</th>
                                    </tr>
                                    <tr>
                                        <td>{!payment['Reference_Number__c']}</td>
                                        <td>
                                            <apex:outputText value="{!payment['Invoice_Number__c']}" rendered="{!payment['Invoice__c'] != null}" />
                                            <apex:outputText value="-" rendered="{!payment['Invoice__c'] == null}" />
                                        </td>
                                        <td>{!payment['formattedReceiptAmount']}</td>
                                        <td>{!payment['POS_Receipt_Number__c']}</td>
                                        <td>{!payment['Mode_of_Payment__c']}</td>
                                    </tr>
                                </table>
                            </apex:outputPanel>
                        </div>
                    </apex:repeat>
                </div>
                
                <div class="flex-container">
                    <div class="flex-item-left"><strong>Amount in words:</strong> {!amountInWords}</div>
                    <div class="flex-item-right"><strong>Amount:</strong> {!currencySymbol} {!formattedReceivedAmount}</div>
                </div>
                <hr />
                <div class="row" style="margin-top: 8px; display: table; width: 100%;">
                    <div class="column" style="width: 75%; vertical-align: top;">
                        <div class="terms">
                            <p><strong>Terms and Conditions:</strong></p>
                            <ul>
                                <li>- The Purchaser must provide proof of all payments to finance@miradevelopments.ae</li>
                                <li>- The Purchaser is responsible for providing accurate details during booking to ensure correct payment allocation.</li>
                                <li>- For cheque payments, receipt is contingent upon cheque clearance.</li>
                            </ul>
                        </div>
                        <div style="margin-top: 15px; font-style: italic; font-weight: normal; font-family: 'Times New Roman', serif; font-size: 14px;">
                            <i>This is a system-generated receipt and does not require signatures.</i>
                        </div>
                    </div>
                    <div class="column" style="width: 25%; text-align: right; vertical-align: top; padding-top: 20px;">
                        <img src="{!$Resource.MIRAVoucherStamp}" alt="Mira Logo" style="display: {!IF(receipt.Project_Name__c == 'GIANFRANCO FERRE RESIDENCES', 'none', '')}; height: 100px; max-width: 100%;"/>
                        <img src="{!$Resource.MIRAVoucherStampRAK}" alt="Mira Logo" style="display: {!IF(receipt.Project_Name__c == 'GIANFRANCO FERRE RESIDENCES', '', 'none')}; height: 100px; max-width: 100%;"/>
                    </div>
                </div>
                <!--<div style="margin-top: 10px; text-align: center;">
                    
                </div>-->
            </div>
        </apex:outputPanel>
    </body>
    </html>
</apex:page>