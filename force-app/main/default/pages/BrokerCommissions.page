<apex:page controller="BrokerCommissionsController" action="{!checkLogin}" showHeader="false"
           sidebar="false" standardStylesheets="false" cache="false" title="Broker Portal — Commissions">
<head><meta name="viewport" content="width=device-width, initial-scale=1"/></head>
<body>
    <c:BrokerStyles />
    <div class="bp-shell">
        <c:BrokerSidebar active="commissions" />
        <div class="bp-main">
            <c:BrokerTopbar title="Commissions" company="{!brokerCompanyName}" />
            <div class="bp-content">
                <div class="bp-h">
                    <h2>Commission Statements</h2>
                    <p>Track what you've earned, what's been paid, and what's outstanding.</p>
                </div>
                <div class="bp-grid bp-kpis">
                    <div class="bp-card bp-kpi"><div class="bp-ic ic-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="22"/><path d="M17 6.5A4 4 0 0 0 13 4h-2a3.5 3.5 0 0 0 0 7h2a3.5 3.5 0 0 1 0 7h-2a4 4 0 0 1-4-2.5"/></svg></div><div class="bp-val">{!totalEarned}</div><div class="bp-lbl">Total Earned</div></div>
                    <div class="bp-card bp-kpi"><div class="bp-ic ic-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></div><div class="bp-val">{!paidTotal}</div><div class="bp-lbl">Paid</div></div>
                    <div class="bp-card bp-kpi"><div class="bp-ic ic-amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><div class="bp-val">{!outstandingTotal}</div><div class="bp-lbl">Outstanding</div></div>
                    <div class="bp-card bp-kpi"><div class="bp-ic ic-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div><div class="bp-val">{!avgRate}</div><div class="bp-lbl">Avg. Rate</div></div>
                </div>

                <div class="bp-card bp-mt">
                    <table class="bp-table">
                        <thead><tr><th>Commission #</th><th>Project</th><th>Unit</th><th>Tower</th><th>Base Amount</th><th>Rate</th><th>Commission</th><th>Status</th></tr></thead>
                        <tbody>
                            <apex:repeat value="{!commissions}" var="c">
                                <tr>
                                    <td>{!c.commNo}</td>
                                    <td>{!c.project}</td>
                                    <td>{!c.unit}</td>
                                    <td>{!c.tower}</td>
                                    <td class="num">{!c.baseAmount}</td>
                                    <td>{!c.rate}</td>
                                    <td class="num">{!c.commission}</td>
                                    <td><span class="bp-badge {!c.badgeClass}">{!c.status}</span></td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                    <apex:outputPanel layout="block" rendered="{!NOT hasCommissions}">
                        <p style="padding:26px; text-align:center; color:#6b7280; margin:0;">No commissions yet.</p>
                    </apex:outputPanel>
                </div>
            </div>
        </div>
    </div>
</body>
</apex:page>