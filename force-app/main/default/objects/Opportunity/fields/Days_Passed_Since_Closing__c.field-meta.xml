<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Passed_Since_Closing__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    DATEVALUE(Booking_Date_Time__c) &lt;= TODAY(),
    TODAY() - DATEVALUE(Booking_Date_Time__c),
    0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Passed Since Closing</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
