<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Shared_RM_Credit_Amount__c</fullName>
    <description>Attributed unit price for the Shared RM: 50% on share deals, 0 on single deals.</description>
    <externalId>false</externalId>
    <formula>IF(Share_Deal__c, Unit_Price__c * 0.5, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Shared RM Credit Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
