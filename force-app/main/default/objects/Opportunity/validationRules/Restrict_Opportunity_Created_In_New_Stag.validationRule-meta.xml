<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Opportunity_Created_In_New_Stag</fullName>
    <active>true</active>
    <description>Restrict opportunity creation to New stage</description>
    <errorConditionFormula>AND(
 ISNEW(),
 TEXT(StageName) &lt;&gt; &apos;New&apos;
)</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>Opportunity can only be created in New Stage</errorMessage>
</ValidationRule>
