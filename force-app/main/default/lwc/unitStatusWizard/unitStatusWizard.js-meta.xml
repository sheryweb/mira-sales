<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Unit Status Wizard</masterLabel>
    <description>Block or release multiple units per project (replaces the Block/Release Multiple Units screen flows). Mode via c__mode URL param or the mode property.</description>
    <targets>
        <target>lightning__UrlAddressable</target>
        <target>lightning__AppPage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage">
            <property name="mode" type="String" label="Mode" description="block or release" default="block"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
