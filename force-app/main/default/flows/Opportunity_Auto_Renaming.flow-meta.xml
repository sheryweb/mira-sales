        <dataType>String</dataType>
        <expression>{!$Record.Account.FirstName} +&apos; &apos;+{!$Record.Account.LastName}+&apos; &apos;+TEXT(   TODAY()   )+&apos; &apos;+{!$Record.Unit__r.Title_Formula__c}</expression>
