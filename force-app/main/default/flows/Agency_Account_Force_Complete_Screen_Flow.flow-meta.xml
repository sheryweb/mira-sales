    <decisions>
        <name>Check_if_Current_Status_is_Half_Executed_or_Completed</name>
        <label>Check if Current Status is Half Executed or Completed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>End Process</defaultConnectorLabel>
        <rules>
            <name>If_Half_Executed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Half Executed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Turn_Off_Completed_Notification_Flag</targetReference>
            </connector>
            <label>If Half Executed</label>
        </rules>
        <rules>
            <name>If_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_The_Status_to_Half_Executed</targetReference>
            </connector>
            <label>If Completed</label>
        </rules>
    </decisions>
