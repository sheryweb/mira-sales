/**
 * SalesOfferEmailController — emails a generated sales offer PDF as an attachment.
 *
 * Exists for the mobile app: the Salesforce app on Android has no way to save a
 * file to the device (the servlet does nothing in its webview and the native
 * preview cannot download), and a public ContentDistribution link was rejected —
 * offers must stay behind login. So phone users email the PDF to themselves
 * (or any address they type) and share it onward from their mail app.
 *
 * NOTE: the working sandbox has email deliverability off — real sends can only
 * be verified in production.
 */
public with sharing class SalesOfferEmailController {
  /** Pre-fill for the recipient box: the generating user's own email. */
  @AuraEnabled(cacheable=true)
  public static String getDefaultEmail() {
    return UserInfo.getUserEmail();
  }

  @AuraEnabled
  public static void emailOffer(String contentDocumentId, String toAddress) {
    if (String.isBlank(contentDocumentId)) {
      throw new AuraHandledException('No sales offer file to email yet.');
    }
    String recipient = toAddress == null ? '' : toAddress.trim();
    if (!Pattern.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$', recipient)) {
      throw new AuraHandledException('Please enter a valid email address.');
    }

    List<ContentVersion> versions = [
      SELECT Title, VersionData
      FROM ContentVersion
      WHERE ContentDocumentId = :((Id) contentDocumentId) AND IsLatest = TRUE
      LIMIT 1
    ];
    if (versions.isEmpty()) {
      throw new AuraHandledException(
        'The sales offer file could not be found.'
      );
    }
    ContentVersion offer = versions[0];

    Messaging.EmailFileAttachment pdf = new Messaging.EmailFileAttachment();
    pdf.setFileName(offer.Title + '.pdf');
    pdf.setBody(offer.VersionData);
    pdf.setContentType('application/pdf');

    Messaging.SingleEmailMessage mail = new Messaging.SingleEmailMessage();
    mail.setToAddresses(new List<String>{ recipient });
    mail.setSubject(offer.Title);
    mail.setPlainTextBody(
      'Please find the sales offer attached.\n\n' +
        'Generated by ' +
        UserInfo.getName() +
        ' via MIRA Sales.'
    );
    mail.setFileAttachments(new List<Messaging.EmailFileAttachment>{ pdf });
    mail.setSaveAsActivity(false);

    try {
      Messaging.sendEmail(new List<Messaging.SingleEmailMessage>{ mail });
    } catch (Exception e) {
      throw new AuraHandledException(
        'The email could not be sent: ' + e.getMessage()
      );
    }
  }
}
